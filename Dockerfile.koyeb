# Base image
FROM node:18-alpine

# Install Docker Compose inside the container
RUN apk add --no-cache py3-pip && pip install docker-compose

# Set the working directory
WORKDIR /app

# Copy all files
COPY . .

# Expose necessary ports (adjust based on services)
EXPOSE 5000 80 6379

# Start all services using docker-compose
CMD ["docker-compose", "up"]
